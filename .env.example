# Local development values. Replace secrets before deploying.
VESTIS_NETWORK=vestis-services
WARDROBE_PORT=8002
DB_USER=vestis
DB_PASSWORD=local-wardrobe-database-password
# Must match auth and outfit.
SECRET_KEY=local-only-shared-jwt-secret-change-before-deployment
# Must match ML.
ML_SERVICE_TOKEN=local-only-ml-callback-token-change-before-deployment
ML_TASKS_QUEUE=ml_tasks
MINIO_ACCESS_KEY=vestis
MINIO_SECRET_KEY=local-only-photo-storage-password
MINIO_BUCKET=wardrobe-photos
# Browser-reachable address; use http://localhost:8080 when using the gateway.
PUBLIC_BASE_URL=http://localhost:8002
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
